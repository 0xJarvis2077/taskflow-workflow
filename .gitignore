# Public repository allowlist. Private working data remains local.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/pyproject.toml
!/LICENSE
!/NOTICE
!/taskflow/
/taskflow/*
!/taskflow/*.py
!/tools/
/tools/*
!/tools/*.py
!/tests/
/tests/*
!/tests/*.py
!/docs/
/docs/*
!/docs/*.md
/docs/*.local.md
!/skills/
/skills/*
!/skills/high-value-task-workflow/
/skills/high-value-task-workflow/*
!/skills/high-value-task-workflow/SKILL.md
!/config/
/config/*
!/config/examples/
/config/examples/*
!/config/examples/*.json

!/knowledge/
/knowledge/*
!/knowledge/index.md
!/knowledge/ingestion.md
!/knowledge/open-questions.template.md
!/knowledge/methods/
/knowledge/methods/*
!/knowledge/methods/*.md
!/knowledge/experience/
/knowledge/experience/*
!/knowledge/experience/*.md
!/knowledge/policy-notes/
/knowledge/policy-notes/*
!/knowledge/policy-notes/*.md
!/knowledge/templates/
/knowledge/templates/*
!/knowledge/templates/*.md
!/knowledge/templates/task-batch-plan.template.json

# Never publish generated files, local overrides, credentials or environments.
**/__pycache__/
*.py[cod]
*.cover
.DS_Store
*.local.md
LOCAL.md
.env
.env.*
*.pem
*.key
